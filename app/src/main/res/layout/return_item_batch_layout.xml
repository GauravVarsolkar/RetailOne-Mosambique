    <LinearLayout
        android:id="@+id/quantity_layouts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="@drawable/shape_curve_grey_small"

        android:layout_marginVertical="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:paddingVertical="3dp"
        android:orientation="horizontal"
        android:weightSum="5"
        app:layout_constraintBottom_toTopOf="@+id/paymentcards"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/batchname_layouts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="0.5"
            android:layout_marginStart="5dp"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/batch_names"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/avenirnextltpro_medium"
                android:text="@string/batch_label"
                android:textSize="13dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/batch_pricelayouts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="4dp"
            android:layout_weight="1.4"
            android:background="@drawable/shape_curve_grey_small"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/batch_prices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/avenirnextltpro_medium"
                android:text="@string/price_label"
                android:textSize="13dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sale_layouts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="4dp"
            android:layout_weight="0.7"
            android:background="@drawable/shape_curve_grey_small"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/sale_quantitys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/avenirnextltpro_medium"
                android:text="@string/stock_label"
                android:textSize="13dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/return_quantity_layouts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/shape_curve_grey_small"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <EditText
                android:id="@+id/return_quantitys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/rounded_edittext_background"
                android:fontFamily="@font/avenirnextltpro_medium"
                android:gravity="center"
                android:hint="@string/quantity_label"
                android:inputType="number"
                android:maxLength="8"
                android:minWidth="80dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="5dp"
                android:textColor="@color/primary"
                android:textSize="15dp"
                android:textStyle="bold" />

        </LinearLayout>
        <LinearLayout
            android:id="@+id/return_reason_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
           android:layout_marginStart="5dp"
            android:layout_weight="1.4"
            android:background="@drawable/shape_curve_grey_small"
            android:orientation="vertical"
            android:paddingVertical="2dp">

          <!--  <EditText
                android:id="@+id/return_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/rounded_edittext_background"
                android:fontFamily="@font/avenirnextltpro_medium"
                android:gravity="center"
                android:hint="Quantity"
                android:inputType="number"
                android:maxLength="8"
                android:minWidth="80dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="5dp"
                android:textColor="@color/primary"
                android:textSize="15dp"
                android:textStyle="bold" />-->
            <TextView
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:focusable="true"
                android:layout_gravity="center_horizontal"

                android:focusableInTouchMode="true"
                android:scrollHorizontally="true"

                android:id="@+id/return_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/avenirnextltpro_medium"
                android:background="@drawable/rounded_edittext_background"

                android:paddingHorizontal="6dp"
                android:paddingVertical="5dp"
                android:textColor="@color/primary"
                android:textSize="15dp"
                android:textStyle="bold"
                android:text="@string/good_label"

                android:gravity="center"

              />

        </LinearLayout>

    </LinearLayout>
