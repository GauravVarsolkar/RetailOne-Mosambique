<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:visibility="gone"
        android:id="@+id/quantity_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginVertical="4dp"
        android:paddingVertical="3dp"
        android:background="@drawable/shape_curve_grey_small"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/paymentcard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <!-- Horizontal strip -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp"
                android:gravity="center_vertical">

                <!-- CONSTANT ROW HEIGHT: 48dp for **every** tile -->

                <!-- Batch -->
                <RelativeLayout
                    android:id="@+id/batchname_layout"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:paddingHorizontal="8dp"
                    android:background="@android:color/transparent">

                    <TextView
                        android:id="@+id/batch_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/batch_label"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/avenirnextltpro_medium"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>

                <!-- Price -->
                <RelativeLayout
                    android:id="@+id/batch_pricelayout"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/shape_curve_grey_small">

                    <TextView
                        android:id="@+id/batch_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/price_label"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/avenirnextltpro_medium"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>

                <!-- Stock -->
                <RelativeLayout
                    android:id="@+id/sale_layout"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/shape_curve_grey_small">

                    <TextView
                        android:id="@+id/sale_quantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stock_label"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/avenirnextltpro_medium"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>

                <!-- Return Quantity -->
                <RelativeLayout
                    android:id="@+id/return_quantity_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/shape_curve_grey_small">

                    <EditText
                        android:id="@+id/return_quantity"
                        android:layout_width="100dp"
                        android:layout_height="match_parent"
                        android:hint="@string/qty_label"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="8"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="6dp"
                        android:includeFontPadding="false"
                        android:background="@drawable/rounded_edittext_background"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:fontFamily="@font/avenirnextltpro_medium"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>

                <!-- Update Button -->
                <RelativeLayout
                    android:id="@+id/update_button_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="6dp"
                    android:background="@drawable/shape_curve_grey_small">

                    <ImageButton
                        android:id="@+id/update_btn"
                        android:layout_width="50dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_dispatch_button"
                        android:src="@drawable/pencil"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/update_button_description"
                        android:tint="@android:color/white"
                        android:padding="8dp"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>



